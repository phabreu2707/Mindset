{
  "manifest_version": 3,
  "name": "Foco Calmo — Acessibilidade para Autismo",
  "version": "2.0",
  "description": "Torna qualquer site mais calmo e fácil de usar: reduz animações, esconde distrações, simplifica fontes e cores para pessoas autistas.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tts"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Foco Calmo"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-modo-calmo": {
      "suggested_key": { "default": "Ctrl+Shift+C" },
      "description": "Ativar/desativar modo calmo"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
