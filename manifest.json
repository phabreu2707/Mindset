{
  "manifest_version": 3,
  "name": "Foco Calmo — Acessibilidade",
  "version": "3.1.0",
  "description": "Ferramenta de acessibilidade para tornar páginas mais calmas, legíveis e com menos distrações.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Foco Calmo"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-modo-calmo": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Ativar ou desativar o modo calmo"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
